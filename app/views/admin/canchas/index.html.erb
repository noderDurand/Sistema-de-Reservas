<div class="page-header">
  <h1>Canchas</h1>
  <%= link_to "+ Nueva cancha", new_admin_cancha_path, class: "btn btn-primary" %>
</div>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Foto</th>
        <th>Nombre</th>
        <th>Capacidad</th>
        <th>Precio</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @canchas.each do |cancha| %>
        <tr>
          <td>
            <% if cancha.foto.attached? %>
              <%= image_tag cancha.foto, class: "thumb", alt: cancha.nombre %>
            <% else %>
              <div class="thumb-placeholder">Sin foto</div>
            <% end %>
          </td>
          <td><strong><%= cancha.nombre %></strong></td>
          <td><%= cancha.capacidad %> jugadores</td>
          <td><%= number_to_currency(cancha.precio, unit: "$", separator: ",", delimiter: ".") %></td>
          <td>
            <div class="actions">
              <%= link_to "Ver", admin_cancha_path(cancha), class: "btn btn-secondary btn-sm" %>
              <%= link_to "Editar", edit_admin_cancha_path(cancha), class: "btn btn-secondary btn-sm" %>
              <%= button_to "Eliminar", admin_cancha_path(cancha), method: :delete,
                    class: "btn btn-danger btn-sm",
                    form: { data: { turbo_confirm: "¿Seguro que querés eliminar esta cancha?" } } %>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @canchas.empty? %>
        <tr><td colspan="5" class="empty">Todavía no hay canchas cargadas.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
