<div class="page-header">
  <h1><%= @cancha.nombre %></h1>
  <div class="actions">
    <%= link_to "Editar", edit_admin_cancha_path(@cancha), class: "btn btn-primary" %>
    <%= link_to "Volver", admin_canchas_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card card-narrow">
  <% if @cancha.foto.attached? %>
    <%= image_tag @cancha.foto, class: "foto-grande", alt: @cancha.nombre %>
  <% end %>

  <dl class="detail-list">
    <dt>Capacidad</dt>
    <dd><%= @cancha.capacidad %> jugadores</dd>

    <dt>Precio</dt>
    <dd><%= number_to_currency(@cancha.precio, unit: "$", separator: ",", delimiter: ".") %></dd>
  </dl>
</div>
