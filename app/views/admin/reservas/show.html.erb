<div class="page-header">
  <h1>Reserva #<%= @reserva.id %></h1>
  <div class="actions">
    <%= link_to "Cambiar estado", edit_admin_reserva_path(@reserva), class: "btn btn-primary" %>
    <%= link_to "Volver", admin_reservas_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card card-narrow">
  <dl class="detail-list">
    <dt>Estado</dt>
    <dd><span class="badge badge-<%= @reserva.estado %>"><%= @reserva.estado %></span></dd>

    <dt>Fecha</dt>
    <dd><%= @reserva.fecha.strftime("%d/%m/%Y") %></dd>

    <dt>Cancha</dt>
    <dd><%= @reserva.cancha.nombre %></dd>

    <dt>Turno</dt>
    <dd><%= @reserva.turno.hora_inicio.strftime("%H:%M") %> - <%= @reserva.turno.hora_fin.strftime("%H:%M") %></dd>

    <dt>Cliente</dt>
    <dd><%= @reserva.user.name %> (<%= @reserva.user.email %>)</dd>
  </dl>
</div>
