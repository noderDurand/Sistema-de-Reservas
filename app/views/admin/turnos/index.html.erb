<div class="page-header">
  <h1>Turnos</h1>
  <%= link_to "+ Nuevo turno", new_admin_turno_path, class: "btn btn-primary" %>
</div>

<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Hora inicio</th>
        <th>Hora fin</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @turnos.each do |turno| %>
        <tr>
          <td><strong><%= turno.hora_inicio.strftime("%H:%M") %></strong></td>
          <td><%= turno.hora_fin.strftime("%H:%M") %></td>
          <td>
            <div class="actions">
              <%= link_to "Ver", admin_turno_path(turno), class: "btn btn-secondary btn-sm" %>
              <%= link_to "Editar", edit_admin_turno_path(turno), class: "btn btn-secondary btn-sm" %>
              <%= button_to "Eliminar", admin_turno_path(turno), method: :delete,
                    class: "btn btn-danger btn-sm",
                    form: { data: { turbo_confirm: "¿Seguro que querés eliminar este turno?" } } %>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @turnos.empty? %>
        <tr><td colspan="3" class="empty">Todavía no hay turnos cargados.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
