<%= form_with model: [:admin, turno] do |f| %>
  <% if turno.errors.any? %>
    <div style="color: red;">
      <% turno.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :hora_inicio %>
    <%= f.time_field :hora_inicio %>
  </div>
  <div>
    <%= f.label :hora_fin %>
    <%= f.time_field :hora_fin %>
  </div>
  <%= f.submit %>
<% end %>