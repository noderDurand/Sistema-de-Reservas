<%= form_with model: [:admin, turno], class: "form" do |f| %>
  <% if turno.errors.any? %>
    <div class="form-errors">
      <strong>No se pudo guardar el turno:</strong>
      <ul>
        <% turno.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :hora_inicio, "Hora de inicio" %>
    <%= f.time_field :hora_inicio %>
  </div>

  <div class="field">
    <%= f.label :hora_fin, "Hora de fin" %>
    <%= f.time_field :hora_fin %>
    <p class="hint">Tiene que ser posterior a la hora de inicio.</p>
  </div>

  <div class="form-actions">
    <%= f.submit "Guardar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_turnos_path, class: "btn btn-secondary" %>
  </div>
<% end %>
