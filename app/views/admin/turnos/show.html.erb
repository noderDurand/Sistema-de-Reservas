<div class="page-header">
  <h1>Turno <%= @turno.hora_inicio.strftime("%H:%M") %> - <%= @turno.hora_fin.strftime("%H:%M") %></h1>
  <div class="actions">
    <%= link_to "Editar", edit_admin_turno_path(@turno), class: "btn btn-primary" %>
    <%= link_to "Volver", admin_turnos_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card card-narrow">
  <dl class="detail-list">
    <dt>Hora inicio</dt>
    <dd><%= @turno.hora_inicio.strftime("%H:%M") %></dd>

    <dt>Hora fin</dt>
    <dd><%= @turno.hora_fin.strftime("%H:%M") %></dd>
  </dl>
</div>
