<div class="login-box">
  <h1>Ingreso administrador</h1>
  <%= form_with url: admin_login_path, method: :post, local: true, class: "login-form" do |f| %>
    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email %>
    </div>
    <div class="field">
      <%= f.label :password, "Contraseña" %>
      <%= f.password_field :password %>
    </div>
    <%= f.submit "Ingresar", class: "btn-submit" %>
  <% end %>
</div>
