<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Admin - Futbol5 Reservas</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-inner">
        <%= link_to "⚽ Futbol5 Admin", (current_user ? admin_root_path : admin_login_path), class: "navbar-brand" %>

        <% if current_user %>
          <div class="navbar-links">
            <%= link_to "Dashboard", admin_root_path, class: ("active" if controller_name == "dashboard") %>
            <%= link_to "Canchas", admin_canchas_path, class: ("active" if controller_name == "canchas") %>
            <%= link_to "Turnos", admin_turnos_path, class: ("active" if controller_name == "turnos") %>
            <%= link_to "Reservas", admin_reservas_path, class: ("active" if controller_name == "reservas") %>
          </div>

          <div class="navbar-user">
            <span><%= current_user.name %></span>
            <%= button_to "Cerrar sesión", admin_logout_path, method: :delete, class: "btn btn-light btn-sm" %>
          </div>
        <% end %>
      </div>
    </nav>

    <main class="container">
      <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
